# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# CAPTCHA (Cloudflare Turnstile). The SITE key is public; the secret key goes only in Supabase.
# Leave empty to show no check (for example while developing).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to true once Google is switched on under Supabase > Authentication > Providers.
NEXT_PUBLIC_GOOGLE_SIGNIN=false
# The site's public address, used for the Google return trip (optional; worked out from the request if empty).
NEXT_PUBLIC_SITE_URL=
